{
  "name": "cardon-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/visuals-check.mjs && node scripts/palette-check.mjs && vitest run --reporter=dot --exclude '**/node_modules/**' --exclude 'scripts/**' --exclude 'tools/**' && npm run copy:check:test && npm run visibility:test",
    "copy:check": "node scripts/visuals-check.mjs && node scripts/copy-check.mjs",
    "copy:check:test": "node --test 'scripts/**/*.test.mjs'",
    "visibility": "node tools/visibility/run.mjs",
    "visibility:test": "node --test 'tools/visibility/test/*.test.mjs'"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "lenis": "^1.3.25",
    "next": "^14.2.5",
    "next-view-transitions": "^0.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.5",
    "jsdom": "26.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
